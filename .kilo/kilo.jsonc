{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": [
    ".kilo/rules/01-strict-tool-calls.md",
    ".kilo/rules/02-system-constraints.md",
    // ".kilo/rules/03-execution-protocol.md",
    ".kilo/rules/04-use-desktop-commander-mcp.md",
    ".kilo/rules/05-use-native-edit-tools.md"
  ],
  "agent": {
    "code": {
      // "model": "local_lm_studio/qwen3.6-27b-a3b-coder",
      "model": "local_lm_studio/ornith-1.5-27b-a3b-coderx-mtp@4_k_m",
      "temperature": 0.7,
      "instructions": [
        "./kilo/rules/03-act-execution-protocol.md"
      ]
    },
    "plan": {
      // "model": "local_lm_studio/qwen3.6-35b-a3b-mtp@q3_k_m",
      // "model": "local_lm_studio/qwen3.8-27b@iq3_xxs",
      "model": "local_lm_studio/qwen3.8-whittle-moe-27b-a17.8b",
      "temperature": 1.0,
      "instructions": [
        "./kilo/rules/03-plan-execution-protocol.md"
      ]
    },
    "planner": {
      "model": "kilo/nvidia/nemotron-3-ultra-120b-a12b:free",
      "temperature": 1.0,
      "instructions": [
        "./kilo/rules/03-plan-execution-protocol.md"
      ],
      "permission": {
        "edit": {
          ".plans/**/*.md": "allow",      // Directly allows writing/modifying in this directory
          ".kilo/plans/**/*.md": "allow", // Retains default behaviour
          "*": "deny"                     // Categorically blocks this agent from editing anything else
        },
        "write": {
          ".plans/**/*.md": "allow",      // Directly allows writing/modifying in this directory
          ".kilo/plans/**/*.md": "allow", // Retains default behaviour
          "*": "deny"                     // Categorically blocks this agent from writing anything else
        }
      }
    },
    "architectreviewer": {
      // "model": "kilo/nvidia/nemotron-3-super-120b-a12b:free",
      "model": "kilo/nvidia/nemotron-3-ultra-120b-a12b:free",
      "temperature": 1.0,
      "instructions": [
        "./kilo/rules/03-architect-execution-protocol.md"
      ],
      "permission": {
        "edit": {
          ".plans/**/*.md": "allow",      // Directly allows writing/modifying in this directory
          ".kilo/plans/**/*.md": "allow", // Retains default behaviour
          "*": "deny"                     // Categorically blocks this agent from editing anything else
        },
        "write": {
          ".plans/**/*.md": "allow",      // Directly allows writing/modifying in this directory
          ".kilo/plans/**/*.md": "allow", // Retains default behaviour
          "*": "deny"                     // Categorically blocks this agent from writing anything else
        }
      }
    }
  },
  "mcp": {
    "desktop-commander": {
      "type": "local",
      "command": ["npx", "-y", "@wonderwhy-er/desktop-commander@latest"],
      "enabled": true
    }
  },
  "snapshot": false
}
